APP_NAME=VPS Gaussian Splatting Backend
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://vps:vps@localhost:5432/vps
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./backend/storage
STORAGE_BACKEND=LOCAL
FFMPEG_BIN=ffmpeg
COLMAP_BIN=colmap
GAUSSIAN_SPLATTING_REPO=
DEFAULT_VIDEO_FPS=2
ORB_NFEATURES=3000
FEATURE_MODE=ORB
SP_MAX_KEYPOINTS=2048
SP_CONF_THRESHOLD=0.001
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=vps-storage

# ──────────────────────────────────────────────────────────────────
# Security & Gating
# ──────────────────────────────────────────────────────────────────

# API key required for write/process/localize endpoints.
# Leave blank (or comment out) to disable auth in local dev.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Set to false in production to block DELETE /scene/{id}/cleanup
# and DELETE /scene/{id}/anchors/{anchor_id}
ALLOW_DESTRUCTIVE_ENDPOINTS=true

# Set to false in production to block GET /debug-path
ALLOW_DEBUG_ENDPOINTS=false

# Maximum upload file size in megabytes (default: 2000 MB = ~2 GB)
MAX_UPLOAD_SIZE_MB=2000
